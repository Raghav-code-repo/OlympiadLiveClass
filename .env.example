# ==============================================================================
# Database Configuration (Microsoft SQL Server)
# Local development connects to local SQL Server Express via Windows Integrated Security.
# ==============================================================================
DATABASE_URL="sqlserver://localhost:1433;database=EduSDb;integratedSecurity=true;trustServerCertificate=true;"
# production (Azure SQL):
# DATABASE_URL="sqlserver://<server>.database.windows.net:1433;database=EduSDb;user=<u>;password={<p>};encrypt=true;connectionLimit=5;poolTimeout=20"

# ==============================================================================
# Server Ports & URLs
# ==============================================================================
PORT=5000
REALTIME_PORT=4000
NODE_ENV=development

VITE_API_URL="http://localhost:5000"
VITE_REALTIME_URL="http://localhost:4000"
VITE_LIVEKIT_URL="ws://localhost:7880"

# ==============================================================================
# Authentication & JWT Secrets
# ==============================================================================
# Secret key used for signing short-lived access tokens (15m)
JWT_ACCESS_SECRET="olympiad_dev_access_secret_32_characters_minimum_12345"
# Secret key used for signing long-lived refresh tokens (7d)
JWT_REFRESH_SECRET="olympiad_dev_refresh_secret_32_characters_minimum_12345"

# ==============================================================================
# LiveKit Video & Audio SFU Configuration
# ==============================================================================
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
LIVEKIT_URL="http://localhost:7880"

# ==============================================================================
# Storage Configuration (Local Filesystem vs S3 / Cloudflare R2 / MinIO)
# Set STORAGE_PROVIDER to "local" for development, or "s3" for production
# ==============================================================================
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./uploads"

# S3-compatible configuration (MinIO in local dev, Cloudflare R2 / AWS S3 in prod)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="edus-recordings"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"
